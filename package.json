{
  "name": "dfresh",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@googleapis/sheets": "^18.1.1",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.3",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.6",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:server\" \"npm:start\"",
    "dev:fresh": "npm run stop && npm run dev",
    "server": "nodemon server.js",
    "start": "node scripts/start-web.js",
    "stop": "node scripts/stop.js",
    "prebuild": "node scripts/i18n-fallback.js",
    "build": "react-scripts build",
    "postbuild": "node scripts/prerender.js",
    "prerender": "node scripts/prerender.js",
    "i18n:fallback": "node scripts/i18n-fallback.js",
    "test": "react-scripts test",
    "db:reset": "node scripts/db-reset.js",
    "media:sync": "node scripts/media-sync.js && npm run media:build",
    "media:build": "node scripts/media-build.js",
    "fonts:build": "node scripts/fonts-build.js",
    "fonts:source": "node scripts/fonts-source.js",
    "cache:bust": "node scripts/cache-bust.js",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:admin-nav": "node scripts/admin-check/admin-nav.js",
    "test:fonts-e2e": "node scripts/admin-check/fonts-e2e.js",
    "release:pack": "node scripts/release-pack.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "config/",
      "src/backend_routes/",
      "src/shared/"
    ],
    "ext": "js,json"
  }
}
