# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# secrets (every .env file except the committed template)
.env*
!.env.example

# served media is rebuilt from assets/ with `npm run media:sync`; production media is uploaded via admin
/media

# private files (brochures) never go to git
/private/*
!/private/.gitkeep
!/private/brochures/
/private/brochures/*
!/private/brochures/.gitkeep

# visual QA screenshots
/visual-output

# editor: only the shared F5 "Run Backend" config is committed
/.vscode/*
!/.vscode/launch.json

# misc
.DS_Store
npm-debug.log*
