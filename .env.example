# ===== dFresh - copy to .env and fill in. NEVER commit .env =====

# --- server ---
PORT=4012
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000

# --- database (same MySQL server as the other dApps) ---
DB_HOST=localhost
DB_USER=dfresh_app
DB_PASSWORD=change-me
DB_NAME=dfresh
DADMIN_DB_NAME=dadmin
# OPTIONAL, used ONLY by scripts/db-reset.js (local dev). Set both when DB_USER is a limited user that cannot
# DROP / CREATE databases; leave both out and db:reset logs in with DB_USER / DB_PASSWORD.
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=change-me
# OPTIONAL, for `npm run db:reset -- --create-app-user`: the limited app user to create (production must not use root)
# APP_DB_USER=dfresh_app
# APP_DB_PASSWORD=change-me-long-random

# --- auth (admin only). JWT_SECRET must be the SAME value dAdmin uses ---
JWT_SECRET=change-me-shared-with-dadmin
ADMIN_APP_KEY=dFresh
ADMIN_COOKIE_NAME=dfresh_admin_token

# --- mail (SendGrid). MAIL_ENABLED=false keeps mail in the outbox and logs it ---
SENDGRID_API_KEY=SG.change-me
MAIL_ENABLED=false

# --- Google Sheet lead sync. GSHEET_ENABLED=false keeps rows in sync_outbox ---
GSHEET_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=./private/google-service-account.json

# --- security ---
IP_HASH_SALT=change-me-random-64-chars
BROCHURE_TOKEN_TTL_MIN=15
LEAD_RATE_LIMIT_PER_10MIN=5

# --- React (build time) ---
REACT_APP_API=https://api.example-dfresh-domain.in
REACT_APP_SITE_URL=https://example-dfresh-domain.in
